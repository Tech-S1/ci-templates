{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "assignees": ["Tech-S1"],
  "reviewers": ["Tech-S1"],
  "timezone": "Europe/London",
  "schedule": ["* 7 * * *"],
  "packageRules": [
    {
      "description": "Group Trivy action digest and binary version updates",
      "matchPackageNames": [
        "aquasecurity/trivy-action",
        "aquasecurity/trivy"
      ],
      "groupName": "trivy"
    },
    {
      "description": "Group golangci-lint action digest and binary version updates",
      "matchPackageNames": [
        "golangci/golangci-lint-action",
        "golangci/golangci-lint"
      ],
      "groupName": "golangci-lint"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update semantic-release packages pinned by git SHA",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "github:(?<depName>semantic-release/[\\w-]+)#(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}

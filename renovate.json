{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>Tech-S1/ci-templates"],
  "packageRules": [
    {
      "description": "Group Trivy action digest and binary version updates",
      "matchPackageNames": [
        "aquasecurity/trivy-action",
        "aquasecurity/trivy"
      ],
      "groupName": "trivy"
    },
    {
      "description": "Group golangci-lint action digest and binary version updates",
      "matchPackageNames": [
        "golangci/golangci-lint-action",
        "golangci/golangci-lint"
      ],
      "groupName": "golangci-lint"
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default Renovate preset for Tech-S1 repos",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "groupName": "security",
    "semanticCommitType": "fix"
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "assignees": ["Tech-S1"],
  "reviewers": ["Tech-S1"],
  "timezone": "Europe/London",
  "schedule": ["* 7 * * *"],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Raise pinDigest updates immediately (safer than leaving unpinned)",
      "matchUpdateTypes": ["pinDigest"],
      "minimumReleaseAge": null
    },
    {
      "description": "Private CI templates: no release age, no digest pins (github-tags digest lookup fails)",
      "matchPackageNames": [
        "Tech-S1/ci-templates",
        "Tech-S1/ci-templates/**"
      ],
      "minimumReleaseAge": null,
      "pinDigests": false
    }
  ]
}
